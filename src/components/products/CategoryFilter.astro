---
import { productFilters } from '../../data/products';
---
<div class="filters" role="group" aria-label="Tatlı kategorileri" hidden>
  {productFilters.map(filter => <button type="button" data-filter={filter.id} aria-pressed={filter.id === 'all' ? 'true' : 'false'} aria-controls="product-grid">{filter.label} <span aria-hidden="true">{String(filter.count).padStart(2, '0')}</span></button>)}
</div>
<p id="filter-status" class="sr-only" role="status" aria-live="polite"></p>
