---
import "../styles/global.css";
---

<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Cappadocia Profiterol — web sitemiz yapım aşamasındadır." />
    <title>Cappadocia Profiterol | Yapım Aşamasında</title>
  </head>
  <body class="min-h-screen bg-orange-50 text-gray-800 antialiased">
    <main class="mx-auto flex min-h-screen max-w-lg flex-col items-center justify-center px-5 py-12 text-center">
      <img
        src="/image01.jfif"
        alt="Cappadocia Profiterol"
        class="mb-8 w-full max-w-md rounded-2xl object-cover shadow-sm"
      />

      <h1 class="text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">
        Cappadocia Profiterol
      </h1>

      <p class="mt-3 max-w-md text-base leading-relaxed text-gray-600 sm:text-lg">
        Web sitemiz yapım aşamasındadır. Çok yakında hizmetinizdeyiz!
      </p>

      <div class="mt-8 w-full max-w-md space-y-4 rounded-2xl bg-white/80 px-5 py-6 text-sm shadow-sm sm:text-base">
        <p class="leading-relaxed text-gray-700">
          15 Temmuz, Vefa Küçük Cd. 91/A,<br />
          50100 Nevşehir Merkez/Nevşehir
        </p>

        <div class="space-y-1 text-gray-800">
          <p>
            Polat Ceylan:
            <a href="tel:+905011663464" class="font-medium hover:underline">
              +90 501 166 34 64
            </a>
          </p>
          <p>
            Umut Ceylan:
            <a href="tel:+905078941841" class="font-medium hover:underline">
              +90 507 894 18 41
            </a>
          </p>
        </div>
      </div>

      <div class="mt-8 flex w-full max-w-md flex-col gap-3 sm:flex-row">
        <a
          href="https://wa.me/905011663464"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex flex-1 items-center justify-center rounded-xl bg-green-600 px-5 py-3 text-sm font-medium text-white shadow-sm transition hover:bg-green-700"
        >
          WhatsApp'tan Ulaşın
        </a>
        <a
          href="https://www.google.com/maps/search/?api=1&query=15+Temmuz,+Vefa+Küçük+Cd.+91/A,+50100+Nevşehir+Merkez/Nevşehir"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex flex-1 items-center justify-center rounded-xl bg-slate-600 px-5 py-3 text-sm font-medium text-white shadow-sm transition hover:bg-slate-700"
        >
          Yol Tarifi Al
        </a>
      </div>
    </main>
  </body>
</html>
