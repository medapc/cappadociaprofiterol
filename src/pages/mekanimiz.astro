---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GalleryPhoto from '../components/GalleryPhoto.astro';
import { getGalleryImages } from '../lib/gallery-images';
import { getPublication } from '../lib/seo';
import { site } from '../data/site';
const photos = await getGalleryImages();
const { origin } = getPublication(Astro.site);
const structuredData = {
  '@context': 'https://schema.org', '@type': 'ImageGallery', name: `${site.name} — Mekânımız`,
  description: 'Nevşehir’deki mekânımızın iç alanı, tatlı vitrinleri ve dış cephesinden fotoğraflar.',
  ...(origin ? { url: new URL('/mekanimiz/', origin).href, about: { '@id': new URL('/#isletme', origin).href },
    image: photos.map(photo => ({ '@type': 'ImageObject', contentUrl: new URL(photo.full.src, origin).href, caption: photo.title, description: photo.alt, width: photo.width, height: photo.height })) } : {}),
};
const socialImage = { src: photos[0].full.src, width: photos[0].width, height: photos[0].height, alt: photos[0].alt };
---
<Layout title={`Mekânımız ve Fotoğraflar | ${site.name} · Nevşehir`} description="Cappadocia Profiterol Nevşehir: dükkânımızın iç mekânını, ekler vitrinlerini, oturma alanlarını ve dış cephesini fotoğraflarla keşfedin." structuredData={structuredData} socialImage={socialImage}>
  <Header />
  <main id="icerik" class="container section shop-gallery-page">
    <nav class="breadcrumbs" aria-label="İçerik yolu"><a href="/">Ana sayfa</a><span aria-hidden="true">/</span><span aria-current="page">Mekânımız</span></nav>
    <div class="shop-gallery-heading"><p class="eyebrow">CAPPADOKIA PROFİTEROL · NEVŞEHİR</p><h1>İçeriye bir <em>göz atın.</em></h1><p>Tatlı vitrinlerimiz, oturma köşelerimiz ve dükkânımızdan dokuz kare.<br />Fotoğraflara dokunarak daha yakından inceleyebilirsiniz.</p></div>
    <div class="shop-gallery-grid">{photos.map((photo, index) => <GalleryPhoto photo={photo} index={index} />)}</div>
    <div class="shop-gallery-action"><p>Bir tatlı molasında da yüz yüze buluşalım.</p><a class="text-link" href="/#konum">Adres ve iletişim <span aria-hidden="true">↗</span></a></div>
  </main>
  <dialog class="gallery-dialog" aria-labelledby="gallery-dialog-title">
    <div class="gallery-dialog-content">
      <div class="gallery-dialog-header"><p id="gallery-dialog-title">Mekânımızdan kareler</p><form method="dialog"><button type="submit" autofocus>Kapat <span aria-hidden="true">×</span></button></form></div>
      <figure><div data-gallery-stage></div><figcaption data-gallery-caption aria-live="polite" aria-atomic="true"></figcaption></figure>
      <div class="gallery-dialog-controls"><button type="button" data-gallery-previous aria-label="Önceki fotoğraf">←</button><span data-gallery-counter aria-hidden="true"></span><button type="button" data-gallery-next aria-label="Sonraki fotoğraf">→</button></div>
    </div>
  </dialog>
  <Footer />
</Layout>
<script>import '../scripts/gallery';</script>
