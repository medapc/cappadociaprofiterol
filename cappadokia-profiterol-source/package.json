{
  "name": "cappadokia-profiterol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "build:production": "node scripts/check-production.mjs && astro build && node --experimental-strip-types scripts/verify-build.mjs",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "test:browser": "node --experimental-strip-types scripts/browser-check.mjs",
    "verify": "node --experimental-strip-types --test scripts/*.test.mjs && astro check && astro build && node --experimental-strip-types scripts/verify-build.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^6.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "typescript": "^5.9.0"
  }
}
