---
import type { GetStaticPaths } from 'astro';
import { products, categories, type Product } from '../../data/products';
import { site } from '../../data/site';
import { getPublication } from '../../lib/seo';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductImage from '../../components/products/ProductImage.astro';
import WeightSelector from '../../components/products/WeightSelector.astro';
export const getStaticPaths = (() => products.map(product => ({ params: { id: product.id }, props: { product } }))) satisfies GetStaticPaths;
interface Props { product: Product; }
const { product } = Astro.props;
const category = categories.find(category => category.id === product.category)!;
const { origin } = getPublication(Astro.site);
// MenuItem describes a catalogue item without implying an online checkout or stock status.
const structuredData = {
  '@context': 'https://schema.org', '@type': 'MenuItem', name: product.name, description: product.description,
  ...(origin ? { url: new URL(Astro.url.pathname, origin).href } : {}),
  offers: product.variants.filter(variant => variant.price !== null).map(variant => ({
    '@type': 'Offer', name: `${product.name} — ${variant.weight}`, price: variant.price, priceCurrency: 'TRY',
    ...(origin ? { url: new URL(Astro.url.pathname, origin).href } : {}),
  })),
};
---
<Layout title={`${product.name} | ${site.name} · Nevşehir`} description={`${product.description} ${site.name}, Nevşehir: gramaj seçeneklerini ve fiyatları inceleyin.`} structuredData={structuredData}>
  <Header />
  <main id="icerik" class="container product-detail section" data-product-detail>
    <nav class="breadcrumbs" aria-label="İçerik yolu"><a href="/">Ana sayfa</a><span aria-hidden="true">/</span><a href="/#urunler">Ürünler</a><span aria-hidden="true">/</span><span aria-current="page">{product.name}</span></nav>
    <div class="product-detail-grid">
      <ProductImage image={product.image} name={product.name} priority />
      <div><p class="eyebrow">{category.label}</p><h1>{product.name}</h1><WeightSelector product={product} /><p class="detail-note">Ürün içerikleri ve alerjen bilgisi için <a class="text-link" href={`tel:${site.phone}`}>bizi arayın</a>.</p><a class="text-link" href="/#urunler">← Tüm tatlıları keşfet</a></div>
    </div>
  </main>
  <Footer />
</Layout>
